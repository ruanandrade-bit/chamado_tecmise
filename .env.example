# ============================================
# 🤖 DISCORD BOT CONFIG
# ============================================
# Pegue em: https://discord.com/developers/applications
DISCORD_TOKEN=cole_seu_token_aqui
DISCORD_CLIENT_ID=cole_seu_client_id_aqui

# ============================================
# 🧠 OPENAI API CONFIG
# ============================================
# Pegue em: https://platform.openai.com/api-keys
OPENAI_API_KEY=cole_sua_api_key_aqui

# ============================================
# 🧠 MODELOS DA IA (MAIS BARATO JÁ CONFIGURADO)
# ============================================
# Opções de chat: gpt-4o-mini (barato), gpt-4o (melhor), gpt-3.5-turbo (mais barato)
# Opções de imagem: dall-e-3 (melhor), dall-e-2 (mais barato, menor qualidade)
# Qualidade imagem: standard (barato) ou hd (melhor, +dobro do preço)
# Estilo imagem: vivid (vibrante) ou natural (realista)
OPENAI_MODELO_CHAT=gpt-4o-mini
OPENAI_MODELO_VISION=gpt-4o-mini
OPENAI_MODELO_IMAGEM=dall-e-3
OPENAI_IMAGEM_QUALIDADE=standard
OPENAI_IMAGEM_ESTILO=vivid
# ============================================
# 🏢 PERFIL DA EMPRESA (CONFIGURE AQUI)
# ============================================
EMPRESA_NOME=Nome da Empresa
EMPRESA_DESCRICAO=O que a empresa faz
EMPRESA_PUBLICO=Público-alvo da empresa
EMPRESA_TOM=moderno, premium
EMPRESA_CORES=Azul escuro (#1a1a2e), Dourado (#e2b714), Branco (#ffffff)
EMPRESA_ESTILO=elegante e minimalista
EMPRESA_OBJETIVO=vendas e engajamento
