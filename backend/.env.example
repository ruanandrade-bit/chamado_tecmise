PORT=4000
# OBRIGATÓRIO: gere um segredo forte com: node -e "require('crypto').randomBytes(48).toString('hex')|console.log"
# Mínimo 32 chars — valores curtos ativam modo efêmero (todos deslogados ao reiniciar)
JWT_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO_DE_96_CHARS
CORS_ORIGIN=http://localhost:3000,https://chamdo-tecmise.vercel.app

# MongoDB Atlas — leave empty for local JSON file fallback
# Get your free connection string at: https://cloud.mongodb.com
MONGODB_URI=

# Tailscale (Devices Online)
# API key de leitura dos devices (prefixo tskey-api-...)
TAILSCALE_API_KEY=
# Alias aceito também: TAILSCALE_API_TOKEN
# Opcional: use '-' para tailnet padrão da chave, ou informe explicitamente (ex: minhaempresa.com)
TAILSCALE_TAILNET=-
